[Unit]
Description=dev-watch — local process monitor
After=network.target

[Service]
Type=simple
User=__USER__
WorkingDirectory=__PATH__
ExecStart=__PATH__/.venv/bin/python3 -m src.server
Restart=on-failure
RestartSec=5
# Hardening (defense-in-depth; the app only reads /proc, ss and the docker socket)
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
